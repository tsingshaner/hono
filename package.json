{
  "name": "hono-template",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "description": "a template for hono",
  "author": {
    "name": "qingshaner",
    "url": "https://github.com/Jon-a-than"
  },
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.21.0",
    "pnpm": ">=11.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm run --parallel '/^build:.*/'",
    "build:client": "tsdown",
    "build:server": "nitro build",
    "changeset-version": "changeset version",
    "changeset-publish": "changeset publish",
    "check": "biome check . --write",
    "check:cspell": "cspell . --no-summary --no-progress --gitignore",
    "check:type": "tsc --noEmit",
    "dev": "nitro dev",
    "knip": "knip",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@logtape/drizzle-orm": "^2.4.2",
    "@logtape/hono": "^2.4.2",
    "@logtape/logtape": "^2.4.2",
    "@neondatabase/serverless": "^1.2.0",
    "@qingshaner/utility-hono": "^0.1.0",
    "better-auth": "^1.7.14",
    "c12": "4.0.0-beta.5",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "hono": "^4.13.15",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "unstorage": "^1.17.6",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^2.31.1",
    "@qingshaner/devtools": "^2.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "cspell": "^10.4.0",
    "drizzle-kit": "1.0.0-rc.4-5d5b77c",
    "knip": "^6.44.1",
    "nano-staged": "^1.0.2",
    "nitro": "3.0.261029-rc",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged",
    "pre-push": "pnpm run --parallel '/(test|check|check:cspell|check:type|knip)/'"
  },
  "nano-staged": {
    "*": "cspell --no-summary --no-progress --gitignore --no-must-find-files --file-list",
    "*.{json,jsonc,js,jsx,cjs,mjs,ts,tsx,cts,mts,html,svg,css,vue}": "pnpm biome check --fix --files-ignore-unknown=true --no-errors-on-unmatched"
  }
}
